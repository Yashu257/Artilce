# Cipla MedKnowledge Platform v2 — root environment template
#
# This file is a POINTER ONLY. Placeholders, no real values — never put a
# real secret here and never commit a filled-in `.env`.
#
# There is no single root `.env` that the app reads. Copy each section to
# the file its service actually loads:
#
#   Backend  -> backend/.env        (see backend/.env.example)
#   Frontend -> frontend/.env.local (see frontend/.env.example)
#
# ---------------------------------------------------------------- backend
# File: backend/.env
# ----------------------------------------------------------------
# MySQL connection string for the `medical_knowledge_db` database.
# Example: mysql://mkp:<password>@localhost:3306/medical_knowledge_db
DATABASE_URL="mysql://mkp:<password>@localhost:3306/medical_knowledge_db"

# Required in production. Long random string; login refuses to issue
# tokens without it. Generate with: openssl rand -base64 48
JWT_SECRET="<generate-a-long-random-secret>"

PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"

# Optional — enable real embeddings / LLM generation. Leave both unset
# for the local TF-IDF fallback + extractive assistant (no key required,
# no data leaves the machine).
OPENAI_API_KEY="<optional>"
GEMINI_API_KEY="<optional>"

# Optional — Qdrant vector DB. Leave unset to use the local JSON vector
# index (backend/data/vector-index.json).
QDRANT_URL=""
QDRANT_API_KEY="<optional>"
QDRANT_COLLECTION="cipla-medknowledge"

# Optional — uploads directory (default: uploads, relative to backend/).
UPLOADS_DIR="uploads"

# --------------------------------------------------------------- frontend
# File: frontend/.env.local
# ---------------------------------------------------------------
# NOTE the exact variable name: NEXT_PUBLIC_API_URL (with the /api/v1
# suffix). The frontend reads this name in frontend/lib/api.ts; the older
# name NEXT_PUBLIC_API_BASE_URL is NOT read and is ignored if set.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
