# Copy to .env — never commit real secrets. Placeholders only.
DATABASE_URL="mysql://user:password@localhost:3306/medical_knowledge_db"
JWT_SECRET="change-me-to-a-long-random-secret"
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
# Optional — enable real embeddings / generation. Leave unset for the local
# TF-IDF fallback + extractive assistant (no key required, no data leaves the VM).
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# Optional — Qdrant vector DB. Leave unset to use the local JSON vector index.
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="cipla-medknowledge"
